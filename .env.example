# --- Aliyun Bailian Coding Plan (OpenAI-compatible) ---
CODING_API_KEY=
CODING_BASE_URL=https://coding.dashscope.aliyuncs.com/v1

# Vision model (must be one of: qwen3.6-plus, qwen3.5-plus, kimi-k2.5)
DEFAULT_MODEL=qwen3.6-plus
FALLBACK_MODEL=qwen3.5-plus

# --- Pipeline knobs ---
TARGET_DURATION=60
MIN_SCORE=0.5
NUM_FRAMES=16
WORKSPACE=./workspace

# --- ASR (optional, vision-only when noop) ---
# Supported: noop | dashscope (paraformer integration is v0.2 WIP)
ASR_PROVIDER=noop
# Required only when ASR_PROVIDER != noop. NOTE: Coding Plan key cannot call ASR;
# use a separate Bailian general-purpose key here.
ASR_API_KEY=
